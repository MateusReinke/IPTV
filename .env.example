# ---------------------------------------------------------------------------
# Subindo com docker-compose.yml (recomendado)
#
#   ./scripts/setup-env.sh && docker compose up -d
#
# O script gera um .env com senha do banco e chave de criptografia aleatorias,
# e o compose sobe o Postgres junto com o app. No Coolify (build pack "Docker
# Compose") nem isso e necessario: as variaveis SERVICE_* sao geradas pela
# propria plataforma.
#
# As variaveis abaixo sao para quem prefere rodar o app sozinho, apontando
# para um Postgres proprio.
# ---------------------------------------------------------------------------

# Unica variavel obrigatoria. As migracoes rodam sozinhas na primeira
# requisicao.
DATABASE_URL=postgres://usuario:senha@host:5432/multitela
# Postgres gerenciado (Neon, Supabase, RDS) costuma exigir TLS:
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Recomendadas
# ---------------------------------------------------------------------------

# Criptografa favoritos e historico gravados no banco. Aceita 32 bytes em
# base64 ou qualquer texto aleatorio com 16+ caracteres. Sem ela o app
# funciona, mas a sincronizacao entre aparelhos fica desligada.
# Trocar o valor torna o que ja foi sincronizado ilegivel.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Contas que viram admin automaticamente (separadas por virgula).
ADMIN_EMAILS=voce@exemplo.com

# URL publica, usada nos retornos de pagamento e nos links de redefinicao.
# Sem ela o app usa a origem da requisicao.
APP_URL=

# Assina os tokens de reproducao. Opcional: quando ausente, o app gera a chave
# na primeira reproducao e a guarda no banco.
STREAM_TOKEN_SECRET=

# Marca e precos exibidos. Precisam existir no BUILD (sao embutidos no bundle).
NEXT_PUBLIC_APP_NAME=Multitela
NEXT_PUBLIC_TRIAL_DAYS=7
NEXT_PUBLIC_PRICE_MONTHLY=19.90
NEXT_PUBLIC_PRICE_YEARLY=199

# ---------------------------------------------------------------------------
# Pagamento online (opcional)
#
# Sem estas variaveis o produto funciona: o teste continua sendo criado no
# cadastro e o painel admin libera acesso manualmente (PIX, transferencia...).
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
