# ---------------------------------------------------------------------------
# Subindo com docker-compose.yml (recomendado)
#
#   ./scripts/setup-env.sh && docker compose up -d
#
# O script gera um .env com senha do banco e chave de criptografia aleatorias,
# e o compose sobe o Postgres junto com o app. No Coolify (build pack "Docker
# Compose") nem isso e necessario: as variaveis SERVICE_* sao geradas pela
# propria plataforma.
#
# As variaveis abaixo sao para quem prefere rodar o app sozinho, apontando
# para um Postgres proprio.
# ---------------------------------------------------------------------------

# Unica variavel obrigatoria. As migracoes rodam sozinhas na primeira
# requisicao.
DATABASE_URL=postgres://usuario:senha@host:5432/multitela
# Postgres gerenciado (Neon, Supabase, RDS) costuma exigir TLS:
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Recomendadas
# ---------------------------------------------------------------------------

# Criptografa favoritos e historico gravados no banco. Aceita 32 bytes em
# base64 ou qualquer texto aleatorio com 16+ caracteres. Sem ela o app
# funciona, mas a sincronizacao entre aparelhos fica desligada.
# Trocar o valor torna o que ja foi sincronizado ilegivel.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Contas que viram admin automaticamente (separadas por virgula).
ADMIN_EMAILS=voce@exemplo.com

# URL publica, usada nos retornos de pagamento e nos links de redefinicao.
# Sem ela o app usa a origem da requisicao.
APP_URL=

# Assina os tokens de reproducao. Opcional: quando ausente, o app gera a chave
# na primeira reproducao e a guarda no banco.
STREAM_TOKEN_SECRET=

# Marca e precos exibidos. Precisam existir no BUILD (sao embutidos no bundle).
NEXT_PUBLIC_APP_NAME=Mosaico Play
NEXT_PUBLIC_TRIAL_DAYS=7
NEXT_PUBLIC_PRICE_MONTHLY=19.90
NEXT_PUBLIC_PRICE_YEARLY=199
# Avulso: pagamento unico (nao e assinatura) que libera o Premium por 30 dias
# sem renovar sozinho - ver ONE_TIME_PREMIUM_DAYS em lib/server/billing.js.
NEXT_PUBLIC_PRICE_ONCE=19.90

# ---------------------------------------------------------------------------
# Pagamento online (opcional)
#
# Sem estas variaveis o produto funciona: o teste continua sendo criado no
# cadastro e o painel admin libera acesso manualmente (PIX, transferencia...).
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Price id do plano avulso (mode "payment" no Stripe, nao recorrente).
STRIPE_PRICE_ONCE=

# ---------------------------------------------------------------------------
# Recomendacao por IA - "IA escolhe pra voce" (opcional)
#
# Sem estas variaveis o produto funciona normalmente: o botao fica oculto e
# /api/health mostra o aviso. Configure a Anthropic OU a OpenAI - nao precisa
# das duas. Se AI_PROVIDER ficar em branco, o app detecta sozinho pela chave
# presente (Anthropic tem prioridade se ambas estiverem definidas).
# ---------------------------------------------------------------------------

# 'anthropic' ou 'openai'. Deixe em branco para detectar pela chave presente.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Default se vazio: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Default se vazio: gpt-4o-mini
OPENAI_MODEL=
# Para usar um endpoint compativel com a API da OpenAI (proxy, Azure, etc.)
OPENAI_BASE_URL=
# A cada quantos dias, por conta, uma nova recomendacao pode ser pedida -
# controla o custo de API. Precisa existir no BUILD (embutida no bundle).
NEXT_PUBLIC_AI_PICK_COOLDOWN_DAYS=15

# ---------------------------------------------------------------------------
# Login com Google (opcional)
#
# Sem estas variaveis o produto funciona normalmente: so fica disponivel o
# cadastro/login por e-mail e senha, e /api/health mostra o aviso.
#
# Crie um "OAuth client ID" tipo "Web application" no Google Cloud Console
# (APIs & Services > Credentials) e cadastre como "Authorized redirect URI"
# exatamente:  {APP_URL ou o dominio que voce acessa}/api/auth/google/callback
# Ex.: http://localhost:3001/api/auth/google/callback para testar local, e
# https://seu-dominio/api/auth/google/callback para producao (cadastre as
# duas se for testar local e usar em producao).
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
